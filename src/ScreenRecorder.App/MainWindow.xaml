<Window x:Class="ScreenRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ScreenRecorder.App.Views"
        Title="Screen Recorder"
        Width="1180" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="Tabs" Margin="12,8,12,12">
        <TabItem Header="Record">
            <views:RecordView x:Name="Recorder" Margin="0,12,0,0" />
        </TabItem>
        <TabItem x:Name="EditorTab" Header="Play &amp; edit">
            <views:EditorView x:Name="Editor" Margin="0,12,0,0" />
        </TabItem>
    </TabControl>
</Window>
