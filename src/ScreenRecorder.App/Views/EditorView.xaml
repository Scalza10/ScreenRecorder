<UserControl x:Class="ScreenRecorder.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenRecorder.App.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- File + export actions -->
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource ToolbarButton}" Click="Undo_Click"
                        ToolTip="Undo the last edit (Ctrl+Z)" />
                <Button x:Name="ResetButton" Content="Reset edits" Style="{StaticResource ToolbarButton}" Click="Reset_Click" />
                <Button x:Name="ExportGifButton" Content="Export GIF…" Style="{StaticResource ToolbarButton}" Click="ExportGif_Click"
                        ToolTip="Save the selected range (or a range you type) as an animated GIF" />
                <Button x:Name="ExportVideoButton" Content="Export edited video" Style="{DynamicResource AccentButtonStyle}"
                        Padding="14,5" Click="ExportVideo_Click"
                        ToolTip="Save a new MP4 with your edits. The original is never changed." />
            </StackPanel>
            <Button Content="Open…" Style="{StaticResource ToolbarButton}" Click="Open_Click" DockPanel.Dock="Left" />
            <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="6,0,12,0" TextTrimming="CharacterEllipsis"
                       Style="{DynamicResource BodyStrongTextBlockStyle}" />
        </DockPanel>

        <!-- Video -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                              Stretch="Uniform" MediaOpened="Media_Opened" MediaFailed="Media_Failed" />
                <controls:CropOverlay x:Name="CropLayer" />
                <TextBlock x:Name="EmptyText" Foreground="#BBBBBB" FontSize="15" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center"
                           Text="Record something, or open an MP4, to play and edit it here." />
                <Border x:Name="CropHint" Background="#DD000000" CornerRadius="6" Padding="12,6" Margin="0,12,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Foreground="White" Text="Drag over the video to choose the area to keep" />
                </Border>
            </Grid>
        </Border>

        <!-- Timeline -->
        <controls:TimelineControl x:Name="Timeline" Grid.Row="2" Margin="0,12,0,4" />

        <!-- Transport + edit tools -->
        <WrapPanel Grid.Row="3" Margin="0,4,0,0">
            <Button x:Name="PlayButton" Content="▶ Play" Width="92" Style="{StaticResource ToolbarButton}" Click="Play_Click"
                    ToolTip="Play / pause (Space)" />
            <TextBlock x:Name="PositionText" Text="0:00.0 / 0:00.0" FontFamily="Consolas" FontSize="14"
                       VerticalAlignment="Center" Margin="4,0,18,0" MinWidth="150" />

            <Button Content="Set start [" Style="{StaticResource ToolbarButton}" Click="MarkIn_Click"
                    ToolTip="Start the selection at the playhead (I)" />
            <Button Content="] Set end" Style="{StaticResource ToolbarButton}" Click="MarkOut_Click"
                    ToolTip="End the selection at the playhead (O)" />
            <TextBlock x:Name="SelectionText" Text="No selection" VerticalAlignment="Center" Margin="4,0,18,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" MinWidth="170" />

            <Button x:Name="TrimButton" Content="Keep only selection" Style="{StaticResource ToolbarButton}" Click="Trim_Click"
                    ToolTip="Trim: remove everything before and after the selection" />
            <Button x:Name="CutButton" Content="Cut selection" Style="{StaticResource ToolbarButton}" Click="Cut_Click"
                    ToolTip="Remove the selected part from the middle of the video (Delete)" />
            <Button x:Name="RestoreButton" Content="Restore selection" Style="{StaticResource ToolbarButton}" Click="Restore_Click"
                    ToolTip="Bring back cut sections inside the selection" />

            <ToggleButton x:Name="CropButton" Content="Crop" Margin="12,0,6,0" Padding="12,5" Checked="Crop_Toggled" Unchecked="Crop_Toggled"
                          ToolTip="Drag over the video to choose the area to keep" />
            <Button x:Name="ClearCropButton" Content="No crop" Style="{StaticResource ToolbarButton}" Click="ClearCrop_Click" />

            <TextBlock Text="Speed" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox x:Name="SpeedBox" Width="90" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="0.25×" Tag="0.25" />
                <ComboBoxItem Content="0.5×" Tag="0.5" />
                <ComboBoxItem Content="0.75×" Tag="0.75" />
                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                <ComboBoxItem Content="1.25×" Tag="1.25" />
                <ComboBoxItem Content="1.5×" Tag="1.5" />
                <ComboBoxItem Content="2×" Tag="2" />
                <ComboBoxItem Content="3×" Tag="3" />
                <ComboBoxItem Content="4×" Tag="4" />
            </ComboBox>
        </WrapPanel>

        <!-- Status -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="6" Minimum="0" Maximum="1"
                         Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"
                       Text="Space: play/pause · I / O: selection start/end · ← →: 1 s (Shift: 5 s) · Shift+drag on the timeline to select" />
        </DockPanel>
    </Grid>
</UserControl>
