<Window x:Class="ScreenRecorder.App.Views.RecordingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording — Screen Recorder"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="#E81123" VerticalAlignment="Center"
                         ToolTip="Drag here to move" />
                <TextBlock x:Name="StateText" Text="REC" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                           ToolTip="Drag here to move" />
                <TextBlock x:Name="TimeText" Text="0:00" FontSize="16" FontFamily="Consolas" Margin="10,0,16,0"
                           VerticalAlignment="Center" MinWidth="64" />
                <Button x:Name="PauseButton" Content="Pause" Width="86" Margin="0,0,6,0" Click="Pause_Click"
                        ToolTip="Ctrl+Shift+F10" />
                <Button x:Name="StopButton" Content="Stop &amp; save" Style="{DynamicResource AccentButtonStyle}"
                        Click="Stop_Click" ToolTip="Ctrl+Shift+F9" />
            </StackPanel>
            <TextBlock x:Name="WarningText" Visibility="Collapsed" MaxWidth="360" TextWrapping="Wrap" FontSize="11"
                       Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        </StackPanel>
    </Border>
</Window>
