<UserControl x:Class="ScreenRecorder.App.Views.RecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- New recording -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="New recording" Style="{DynamicResource SubtitleTextBlockStyle}" />

                <TextBlock Text="Screen" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="MonitorBox" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />

                <TextBlock Text="What to record" Style="{StaticResource FieldLabel}" />
                <RadioButton x:Name="FullScreenOption" Content="Whole screen" IsChecked="True" GroupName="Area" />
                <RadioButton x:Name="RegionOption" Content="Part of the screen" GroupName="Area" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                    <Button x:Name="SelectRegionButton" Content="Select area…" Click="SelectRegion_Click" />
                    <TextBlock x:Name="RegionText" Text="No area selected" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource Hint}" />
                </StackPanel>

                <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="MicBox" HorizontalAlignment="Stretch" />

                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FpsBox" SelectedIndex="0" HorizontalAlignment="Left" Width="160">
                    <ComboBoxItem Content="30 fps" Tag="30" />
                    <ComboBoxItem Content="60 fps" Tag="60" />
                </ComboBox>

                <CheckBox x:Name="CursorBox" Content="Show mouse pointer" IsChecked="True" Margin="0,16,0,0" />

                <Button x:Name="RecordButton" Style="{DynamicResource AccentButtonStyle}" Margin="0,24,0,0"
                        HorizontalAlignment="Stretch" Height="44" FontSize="15" Click="RecordButton_Click"
                        Content="● Start recording" />

                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="While recording: Ctrl+Shift+F10 pauses/resumes, Ctrl+Shift+F9 stops and saves. The recording controls are not captured in the video." />

                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Recordings -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open file…" Style="{StaticResource ToolbarButton}" Click="OpenFile_Click" />
                        <Button Content="Open folder" Style="{StaticResource ToolbarButton}" Click="OpenFolder_Click" />
                        <Button Content="Refresh" Style="{StaticResource ToolbarButton}" Margin="0" Click="Refresh_Click" />
                    </StackPanel>
                    <TextBlock Text="Your recordings" Style="{DynamicResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock x:Name="FolderText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                <Grid>
                    <ListBox x:Name="RecordingsList" MouseDoubleClick="RecordingsList_DoubleClick" KeyDown="RecordingsList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Nothing recorded yet. Your videos and GIFs will appear here." />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
